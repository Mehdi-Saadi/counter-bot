# The bot runs on every messenger it has a token for. Set either one or both;
# a messenger left empty is simply not run.
# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=
# Bale (bale.ai) — from @botfather in Bale
BALE_BOT_TOKEN=

# The day being counted down to. A year before 1700 is read as Jalali:
#   TARGET_DATE=1406-01-01   (Jalali)
#   TARGET_DATE=2027-03-21   (Gregorian)
TARGET_DATE=1406-01-01

# When the count is posted every day, and in which time zone
SEND_TIME=08:00
TIMEZONE=Asia/Tehran

# "trace" | "debug" | "info" | "warn" | "error"
LOG_LEVEL=info
# "development" | "production"
NODE_ENV=development
